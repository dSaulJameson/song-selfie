{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "song-selfie-mailer",
  "main": "index.js",
  "compatibility_date": "2026-09-23",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["info@songselfie.com"]
    }
  ]
}
